---
import AgreementDirectory from '../components/agreements/AgreementDirectory.astro';
import EmptyState from '../components/common/EmptyState.astro';
import PageHero from '../components/common/PageHero.astro';
import SectionHeading from '../components/common/SectionHeading.astro';
import Layout from '../layouts/Layout.astro';
import { getAgreementCategories, getAgreements } from '../lib/content/site';

const agreements = getAgreements();
const categories = getAgreementCategories();
---

<Layout
  title="Convenios y beneficios"
  description="Directorio público de convenios y beneficios disponibles para la comunidad SUTUTCV."
  breadcrumbs={[
    { label: 'Inicio', href: '/' },
    { label: 'Convenios y beneficios' },
  ]}
>
  <PageHero
    eyebrow="Beneficios institucionales"
    title="Convenios y beneficios"
    description="Conoce las novedades sobre convenios y beneficios para la comunidad SUTUTCV."
  />

  <section class="section">
    <div class="container stack-lg">
      {agreements.length > 0 ? (
        <>
          <SectionHeading
            title="Directorio de convenios"
            description="Consulta beneficios, requisitos, restricciones y datos de contacto."
          />
          <AgreementDirectory agreements={agreements} categories={categories} />
        </>
      ) : (
        <EmptyState
          title="Próximos convenios"
          description="En este espacio compartiremos los nuevos convenios y sus beneficios una vez que estén confirmados. Mantente al pendiente de las próximas publicaciones."
        />
      )}
    </div>
  </section>
</Layout>
