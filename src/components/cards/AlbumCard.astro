---
import type { GalleryAlbum } from '../../types/content';

interface Props {
  album: GalleryAlbum;
}

const { album } = Astro.props;
---

<article class="album-card surface-card">
  <a class="album-cover" href={`/galeria/${album.slug}`} tabindex="-1" aria-hidden="true">
    <img
      src={album.cover.src}
      alt=""
      width={album.cover.width}
      height={album.cover.height}
      loading="lazy"
    />
  </a>
  <div class="album-body">
    <p class="album-meta">
      <time datetime={album.date}>{album.dateLabel}</time>
      <span>{album.photos.length} {album.photos.length === 1 ? 'fotografía' : 'fotografías'}</span>
    </p>
    <h3><a href={`/galeria/${album.slug}`}>{album.title}</a></h3>
    <p>{album.description}</p>
    <a class="text-link" href={`/galeria/${album.slug}`}>
      Abrir álbum <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .album-card {
    display: grid;
    overflow: hidden;
  }

  .album-cover {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #edf2f5;
  }

  .album-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .album-body {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: 1.15rem;
  }

  .album-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    color: var(--color-teal-800) !important;
    font-size: 0.86rem;
    font-weight: 800;
  }

  .album-card h3 {
    font-size: 1.15rem;
  }

  .album-card p {
    margin: 0;
    color: var(--color-text-muted);
  }
</style>
