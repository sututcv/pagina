---
import type { HighlightItem } from '../../types/content';

interface Props extends HighlightItem {}

const { eyebrow, title, description, href, tone = 'teal' } = Astro.props;
---

<article class:list={['highlight-card', 'surface-card', `tone-${tone}`]}>
  <div class="card-symbol" aria-hidden="true"></div>
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h3><a href={href}>{title}</a></h3>
    <p>{description}</p>
  </div>
  <a class="card-arrow" href={href} aria-label={`Ver ${title}`}>
    <span aria-hidden="true">→</span>
  </a>
</article>

<style>
  .highlight-card {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    min-height: 9rem;
    padding: 1.2rem;
    box-shadow: none;
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;
  }

  .highlight-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card);
  }

  .card-symbol {
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 50%;
    background:
      radial-gradient(circle at 35% 35%, rgba(255, 255, 255, 0.65), transparent 35%),
      var(--card-accent);
    box-shadow: inset 0 0 0 0.75rem var(--card-soft);
  }

  .tone-teal {
    --card-accent: var(--color-teal-800);
    --card-soft: var(--color-teal-100);
  }

  .tone-blue {
    --card-accent: var(--color-blue-700);
    --card-soft: #dbe7ff;
  }

  .tone-gold {
    --card-accent: var(--color-gold-700);
    --card-soft: #f7e4b8;
  }

  .highlight-card .eyebrow {
    margin-bottom: 0.25rem;
    color: var(--card-accent);
  }

  .highlight-card h3 {
    font-size: 1.1rem;
  }

  .highlight-card h3 a::after {
    position: absolute;
    inset: 0;
    content: '';
  }

  .highlight-card p:not(.eyebrow) {
    margin: 0.35rem 0 0;
    color: var(--color-text-muted);
    line-height: 1.45;
  }

  .card-arrow {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    color: var(--card-accent);
    font-size: 1.25rem;
    font-weight: 900;
  }
</style>
