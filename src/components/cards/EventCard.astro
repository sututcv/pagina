---
import type { EventItem } from '../../types/content';

interface Props {
  event: EventItem;
}

const { event } = Astro.props;
---

<article class="event-card surface-card">
  <a class="event-image" href={`/eventos/${event.slug}`} tabindex="-1" aria-hidden="true">
    <img
      src={event.image.src}
      alt=""
      width={event.image.width}
      height={event.image.height}
      loading="lazy"
    />
  </a>
  <div class="event-body">
    <div class="event-meta">
      <time datetime={event.date}>{event.dateLabel}</time>
      <span class:list={['status-badge', `status-${event.status}`]}>
        {event.status === 'realizado' ? 'Realizado' : 'Próximo'}
      </span>
    </div>
    <h3><a href={`/eventos/${event.slug}`}>{event.name}</a></h3>
    <p>{event.summary}</p>
    <a class="text-link" href={`/eventos/${event.slug}`}>
      Ver actividad <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .event-card {
    display: grid;
    overflow: hidden;
  }

  .event-image {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #edf2f5;
  }

  .event-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .event-body {
    display: grid;
    align-content: start;
    gap: 0.8rem;
    padding: 1.2rem;
  }

  .event-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    color: var(--color-teal-800);
    font-size: 0.9rem;
    font-weight: 800;
  }

  .event-card h3 {
    font-size: 1.2rem;
  }

  .event-card p {
    margin: 0;
    color: var(--color-text-muted);
  }
</style>
