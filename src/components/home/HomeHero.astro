---
import type { HomeContent } from '../../types/content';

interface Props {
  home: HomeContent;
}

const { home } = Astro.props;
---

<section class="home-hero">
  <div class="container hero-shell">
    <div class="hero-copy">
      <p class="eyebrow">{home.hero.eyebrow}</p>
      <h1>{home.hero.headline}</h1>
      <p class="hero-lead">{home.hero.description}</p>
      <div class="button-row">
        {
          home.hero.actions.map((action) => (
            <a
              class:list={[
                'button',
                action.variant === 'secondary' ? 'button-secondary' : 'button-primary',
              ]}
              href={action.href}
            >
              {action.label} <span aria-hidden="true">→</span>
            </a>
          ))
        }
      </div>
    </div>

    <div class="hero-media">
      <img
        src={home.hero.image.src}
        alt={home.hero.image.alt}
        width={home.hero.image.width}
        height={home.hero.image.height}
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  .home-hero {
    background: var(--color-navy-950);
  }

  .hero-shell {
    display: grid;
    width: 100%;
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    padding: 2.5rem max(1rem, calc((100vw - 1180px) / 2));
    background:
      radial-gradient(circle at 10% 100%, rgba(0, 139, 150, 0.35), transparent 18rem),
      linear-gradient(135deg, var(--color-navy-950), var(--color-navy-800));
    color: white;
  }

  .hero-copy .eyebrow {
    color: #99e0e5;
  }

  .hero-copy h1 {
    max-width: 13ch;
    color: white;
    font-size: clamp(2.3rem, 9vw, 4.5rem);
  }

  .hero-lead {
    max-width: 48ch;
    margin: 1rem 0 0;
    color: rgba(255, 255, 255, 0.86);
    font-size: clamp(1.05rem, 2.4vw, 1.25rem);
  }

  .hero-media {
    position: relative;
    min-height: 19rem;
    overflow: hidden;
  }

  .hero-media::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(5, 26, 53, 0.12), transparent 35%);
    content: '';
    pointer-events: none;
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    min-height: 19rem;
    object-fit: cover;
    object-position: center 36%;
  }

  @media (min-width: 58rem) {
    .hero-shell {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: none;
    }

    .hero-copy {
      display: grid;
      align-content: center;
      min-height: 31rem;
      padding-right: clamp(1.5rem, 3vw, 3rem);
      padding-left: max(2rem, calc((100vw - 1180px) / 2));
    }

    .hero-copy h1 {
      font-size: clamp(2.6rem, 3.6vw, 3.3rem);
    }

    .hero-copy::after {
      position: absolute;
      z-index: -1;
      top: 0;
      right: -5rem;
      width: 10rem;
      height: 100%;
      border-radius: 50% 0 0 50%;
      background: linear-gradient(90deg, var(--color-navy-800), var(--color-teal-700));
      content: '';
    }

    .hero-media,
    .hero-media img {
      min-height: 31rem;
    }
  }
</style>
